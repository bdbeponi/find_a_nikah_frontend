# Copy to .env and fill in. Everything here is NEXT_PUBLIC_, so it is baked into
# the browser bundle at build time — never put a secret in this file.
#
# These are read at BUILD time, not at run time. Changing one means rebuilding.

NEXT_PUBLIC_API_LOCAL_URL=http://localhost:8007/
NEXT_PUBLIC_API_PROD_URL=https://backend.findanikah.com/

# "pro" uses NEXT_PUBLIC_API_PROD_URL, anything else uses the local one
NEXT_PUBLIC_ENVIRONMENT=dev

# Used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Getting this wrong publishes a sitemap full of localhost links.
NEXT_PUBLIC_BASE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_NAME=Find A Nikah

# Only needed when uploads go to a bucket/CDN - next/image refuses to optimise
# a host it has not been told about.
NEXT_PUBLIC_IMAGE_HOST=
